{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "plebflix-tv",
  "main": "./dist/worker.js",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "upload_source_maps": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    "GITHUB_REPO": "omnifinn/plebflix-tv"
  },
  "assets": {
    "directory": "./dist/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "plebflix-tv",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "routes": [
    { "pattern": "plebflix.com", "custom_domain": true },
    { "pattern": "www.plebflix.com", "custom_domain": true }
  ]
}
