{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "plebflix-tv",
  // The account that owns plebflix.com (the "PC account"). Not the Mac OAuth default (omnifinn 141fee…).
  "account_id": "f7b1f5882ab68d7dfd785ad6942b2db2",
  "main": "./dist/worker.js",
  "compatibility_date": "2026-10-29",
  "workers_dev": false,
  "upload_source_maps": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./dist/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*", "/suomi", "/suomi/"]
  },
  "ratelimits": [
    { "name": "REC_RL", "namespace_id": "4101", "simple": { "limit": 3, "period": 60 } },
    { "name": "VOTE_RL", "namespace_id": "4102", "simple": { "limit": 30, "period": 60 } },
    { "name": "PLAY_RL", "namespace_id": "4103", "simple": { "limit": 30, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "plebflix-tv",
      "database_id": "bc743ec1-07f3-422b-bb5a-972aa6507996",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "routes": [
    { "pattern": "plebflix.com", "custom_domain": true },
    { "pattern": "www.plebflix.com", "custom_domain": true }
  ]
}
