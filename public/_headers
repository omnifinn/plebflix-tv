/channels/*
  Cache-Control: public, max-age=60

/sources.json
  Cache-Control: public, max-age=300

/styles.css
  Cache-Control: public, max-age=300

/styles/*
  Cache-Control: public, max-age=300

/app.js
  Cache-Control: public, max-age=300

/schedule.js
  Cache-Control: public, max-age=300

/fonts/*
  Cache-Control: public, max-age=86400

/textures/*
  Cache-Control: public, max-age=86400

/brand/*
  Cache-Control: public, max-age=86400

/site.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400

/media/*
  Cache-Control: public, max-age=86400
  Accept-Ranges: bytes
